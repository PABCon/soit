# Supabase — from your project's API settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the client, never prefix NEXT_PUBLIC_.
# Used only for privileged cross-tenant writes (§6.1).
SUPABASE_SERVICE_ROLE_KEY=

# Public origin, used for canonical URLs, hreflang and the sitemap (§4).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. The footer's LinkedIn icon only renders when this is set — no
# placeholder/guessed URL, since a wrong one would be genuinely misleading.
NEXT_PUBLIC_LINKEDIN_URL=
