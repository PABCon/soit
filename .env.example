# Supabase — from your project's API settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the client, never prefix NEXT_PUBLIC_.
# Used only for privileged cross-tenant writes (§6.1).
SUPABASE_SERVICE_ROLE_KEY=

# Public origin, used for canonical URLs, hreflang and the sitemap (§4).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. The footer's LinkedIn icon only renders when this is set — no
# placeholder/guessed URL, since a wrong one would be genuinely misleading.
NEXT_PUBLIC_LINKEDIN_URL=

# Server-only. Sends every app-triggered email (§9.1) — verified sending
# domain is justit.pt (SPF/DKIM, eu-west-1). Get a key at resend.com.
RESEND_API_KEY=

# Optional. Google Analytics (GA4) measurement ID — the cookie-consent
# banner only loads gtag.js after a visitor accepts (not strictly
# necessary, so it needs real consent under ePrivacy Art. 5(3)). Leave
# unset to run with no analytics at all, same as NEXT_PUBLIC_LINKEDIN_URL.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Error monitoring — the user's own Sentry project (org "justit-ol",
# project "justit"), not the Vercel Marketplace integration. DSN is
# public by design (client-only "send," never "read"). Get these from
# Settings → Projects → justit → Client Keys (DSN) in the Sentry
# dashboard.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Server-only, build-time only. Used by withSentryConfig to upload
# source maps — never needed at runtime, never sent to the browser.
SENTRY_AUTH_TOKEN=
